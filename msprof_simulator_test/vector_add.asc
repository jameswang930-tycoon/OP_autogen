// ============================================================================
// 最简 Ascend C Vector Add — CANN 8.5 API 格式
// ============================================================================

#include "kernel_operator.h"

constexpr int32_t BLOCK_SIZE = 256;

class VectorAddKernel {
public:
    __aicore__ void Process(
        AscendC::TPipe* pipe,
        AscendC::GlobalTensor<float> x,
        AscendC::GlobalTensor<float> y,
        AscendC::GlobalTensor<float> z,
        uint32_t totalLength)
    {
        uint32_t blockNum = (totalLength + BLOCK_SIZE - 1) / BLOCK_SIZE;

        for (uint32_t i = 0; i < blockNum; i++) {
            uint32_t offset = i * BLOCK_SIZE;
            uint32_t actualSize = (i == blockNum - 1 && totalLength % BLOCK_SIZE)
                ? totalLength % BLOCK_SIZE : BLOCK_SIZE;

            // Alloc UB tensors
            AscendC::LocalTensor<float> ub_x = pipe->AllocTensor<float>();
            AscendC::LocalTensor<float> ub_y = pipe->AllocTensor<float>();
            AscendC::LocalTensor<float> ub_z = pipe->AllocTensor<float>();

            // GM→UB (MTE2)
            AscendC::DataCopy(ub_x, x[offset], actualSize);
            AscendC::DataCopy(ub_y, y[offset], actualSize);

            // VecAdd (VecUnit)
            AscendC::VecAdd(ub_z, ub_x, ub_y, actualSize);

            // UB→GM (MTE3)
            AscendC::DataCopy(z[offset], ub_z, actualSize);

            // Free
            pipe->FreeTensor(ub_x);
            pipe->FreeTensor(ub_y);
            pipe->FreeTensor(ub_z);
        }
    }
};

extern "C" __global__ __aicore__ void vector_add_custom(
    __gm__ float* x, __gm__ float* y, __gm__ float* z, uint32_t totalLength)
{
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<float> gx(x, totalLength);
    AscendC::GlobalTensor<float> gy(y, totalLength);
    AscendC::GlobalTensor<float> gz(z, totalLength);
    VectorAddKernel kernel;
    kernel.Process(&pipe, gx, gy, gz, totalLength);
}
