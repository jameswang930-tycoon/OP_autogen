// ============================================================================
//  Kernel: Vector Add (非模板，blockLength 硬编码)
// ============================================================================
#include "kernel_operator.h"
using namespace AscendC;

extern "C" __global__ __aicore__ void add_custom(
    __gm__ float* x, __gm__ float* y, __gm__ float* z, uint32_t totalLen)
{
    constexpr uint32_t blockLength = 1024;
    uint32_t blockNum = (totalLen + blockLength - 1) / blockLength;

    for (uint32_t i = 0; i < blockNum; i++) {
        uint32_t offset = i * blockLength;
        uint32_t actualSize = (i == blockNum - 1 && totalLen % blockLength != 0)
            ? totalLen % blockLength : blockLength;

        GlobalTensor<float> xGm, yGm, zGm;
        xGm.SetGlobalBuffer(x + offset, actualSize);
        yGm.SetGlobalBuffer(y + offset, actualSize);
        zGm.SetGlobalBuffer(z + offset, actualSize);

        LocalTensor<float> xLocal, yLocal, zLocal;
        xLocal = Alloc<float, 1024>();
        yLocal = Alloc<float, 1024>();
        zLocal = Alloc<float, 1024>();

        DataCopy(xLocal, xGm, actualSize);
        DataCopy(yLocal, yGm, actualSize);
        PipeBarrier<PIPE_ALL>();

        Add(zLocal, xLocal, yLocal, actualSize);
        PipeBarrier<PIPE_ALL>();

        DataCopy(zGm, zLocal, actualSize);
        PipeBarrier<PIPE_ALL>();
    }
}
