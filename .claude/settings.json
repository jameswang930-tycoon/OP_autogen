{
  "projectName": "OP_autogen_hjkc",
  "enableAllProjectMcpServers": true,
  "effortLevel": "high",
  "outputStyle": "terse-bullets",

  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "deepseek-v4-flash",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "MAX_MCP_OUTPUT_TOKENS": "12000"
  },

  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/filesystem-server",
        "--root",
        "D:\\vscodeproject"
      ]
    },

    "github": {
      "command": "npx",
      "args": ["-y", "@anthropic/github-server"]
    },

    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@anthropic/sequential-thinking-server"]
    },

    "sqlite": {
      "command": "npx",
      "args": ["-y", "@anthropic/sqlite-server", "--db-path", "./data.db"]
    },

    "freebird": {
      "command": "npx",
      "args": ["-y", "@dannyboy2042/freebird-mcp"]
    },

    "ddg-search": {
      "command": "npx",
      "args": ["-y", "@oevortex/ddg_search@latest"]
    },

    "knowledge-keeper": {
      "command": "npx",
      "args": ["-y", "@zsc-glitch/knowledge-keeper-mcp"]
    },

    "metaengine": {
      "command": "npx",
      "args": ["-y", "@metaengine/mcp-server"]
    },

    "deepseek-delegator": {
      "command": "npx",
      "args": ["-y", "claude-code-deepseek-delegator"]
    },

    "token-saver": {
      "command": "npx",
      "args": ["-y", "token-saver-mcp"]
    }
  },

  "permissions": {
    "allow": [
      "mcp__filesystem__*",
      "mcp__github__*",
      "mcp__sequential-thinking__*",
      "mcp__sqlite__*",
      "mcp__freebird__*",
      "mcp__ddg-search__*",
      "mcp__knowledge-keeper__*",
      "mcp__metaengine__*"
    ]
  }
}