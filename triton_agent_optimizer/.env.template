# Triton Agent Optimizer — 环境变量配置
# 复制此文件为 .env 并填入你的真实值
#   cp .env.template .env

# ═══════════════════════════════════════════════════════════════════════════
#  LLM 调用方式 (三选一, 优先级从高到低)
# ═══════════════════════════════════════════════════════════════════════════

# 方式 1: API Key (Windows 本地开发用)
# DeepSeek (推荐, OpenAI 兼容): https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# Anthropic: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# 方式 2: CLI 命令 (服务器内部 agent, 如 nga run)
# LLM_CLI_COMMAND 指定调用的命令, prompt 通过 stdin 传入, 响应从 stdout 读取
LLM_CLI_COMMAND=nga run
# LLM_CLI_TIMEOUT=1200

# 方式 3: 都不配 → stub 模式 (返回占位结果, 仅用于测试)

# ═══════════════════════════════════════════════════════════════════════════
#  msprof 模式
# ═══════════════════════════════════════════════════════════════════════════
# hardware = 真机 msprof (910B3 服务器)
TRITON_AGENT_MSPROF_MODE=hardware

# ═══════════════════════════════════════════════════════════════════════════
# 优化参数 (可选, 覆盖 config.py 默认值)
# ═══════════════════════════════════════════════════════════════════════════
# TRITON_AGENT_MAX_ROUNDS=200
# TRITON_AGENT_TARGET_SPEEDUP=1.5
