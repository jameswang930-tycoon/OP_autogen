// ============================================================================
// 多算子示例 — 模拟 3 个 op 的流水线（含 Cube/Matrix 路径）
// ============================================================================
// 这个 kernel 包含多个操作步骤，可以观察到流水线中的并行情况
// 操作: GM→UB (x) → VecAdd → VecMul → UB→GM
// 预期在 trace.json 中看到: MTE2 → VECTOR → VECTOR → MTE3 的流水线

#include "kernel_operator.h"
using namespace AscendC;

constexpr int32_t TILE_SIZE = 512;

extern "C" __global__ void MultiOpKernel(
    GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    auto pipe = Pipe::Create();

    uint32_t tileNum = (totalLength + TILE_SIZE - 1) / TILE_SIZE;

    for (uint32_t i = 0; i < tileNum; i++) {
        auto ub_x = AllocTensor<half>(pipe, TILE_SIZE);
        auto ub_y = AllocTensor<half>(pipe, TILE_SIZE);
        auto ub_temp = AllocTensor<half>(pipe, TILE_SIZE);
        auto ub_z = AllocTensor<half>(pipe, TILE_SIZE);

        uint32_t actualSize = (i == tileNum - 1)
            ? ((totalLength % TILE_SIZE == 0) ? TILE_SIZE : totalLength % TILE_SIZE)
            : TILE_SIZE;

        // Op1: GM → UB (MTE2)
        DataCopy(ub_x, reinterpret_cast<half*>(x) + i * TILE_SIZE, actualSize);
        DataCopy(ub_y, reinterpret_cast<half*>(y) + i * TILE_SIZE, actualSize);

        // Op2: VecAdd (VecUnit)
        VecAdd(ub_temp, ub_x, ub_y, actualSize);

        // Op3: VecMul (VecUnit)
        VecMul(ub_z, ub_temp, ub_y, actualSize);

        // Op4: UB → GM (MTE3)
        DataCopy(reinterpret_cast<half*>(z) + i * TILE_SIZE, ub_z, actualSize);

        FreeTensor(ub_x);
        FreeTensor(ub_y);
        FreeTensor(ub_temp);
        FreeTensor(ub_z);
    }
}
