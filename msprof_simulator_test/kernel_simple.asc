// ============================================================================
//  最简 AscendC Kernel — 使用最低层 API (避免框架问题)
// ============================================================================
#include "kernel_operator.h"
using namespace AscendC;

class KernelAdd {
public:
    __aicore__ void Process()
    {
        constexpr uint32_t totalLen = 1024;
        constexpr uint32_t blockLen = 256;
        uint32_t loopCount = totalLen / blockLen;

        // 用 TPipe 的同步屏障来产生可观测的流水线指令
        auto pipe = TPipe();

        for (uint32_t i = 0; i < loopCount; i++) {
            // 这些操作会被 msprof 捕获为 MTE 和 VECTOR 事件
            pipe.Barrier(PIPE_MTE2);
            pipe.Barrier(PIPE_V);
            pipe.Barrier(PIPE_MTE3);
        }
    }
};

extern "C" __global__ __aicore__ void kernel_simple()
{
    KernelAdd op;
    op.Process();
}
